{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaiak.invalid/protocol/schema/config-snapshot.schema.json",
  "title": "kaiak config snapshot",
  "description": "The answer to GET /v1/config, and the data of a config event on the stream: a full config document, its version and the epoch the version counts in.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_epoch",
    "version",
    "config"
  ],
  "properties": {
    "config_epoch": {
      "$ref": "common.schema.json#/$defs/config_epoch"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/config_version"
    },
    "config": {
      "$ref": "config.schema.json"
    }
  }
}
