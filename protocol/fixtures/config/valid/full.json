{
  "format_version": 3,
  "global": {
    "limits": [
      { "type": "requests_per_minute", "value": 3000 },
      { "type": "usd_per_month", "value": 5000, "models": ["gpt-4.1", "gpt-4.1-mini"] }
    ],
    "max_request_body_bytes": 8388608,
    "control_outage_grace_ms": 600000,
    "max_n": 4,
    "max_sequences_per_request": 32,
    "max_embedding_inputs": 512,
    "max_concurrent_requests_per_key": 32,
    "queue": { "size": 200, "timeout_ms": 60000 },
    "retries": { "max_attempts": 2 },
    "circuit": { "failure_threshold": 3, "probe_interval_ms": 5000 },
    "metrics": { "key_id_label": true, "group_label": false }
  },
  "backends": {
    "vllm-a": {
      "type": "openai-compatible",
      "base_url": "http://vllm-a.internal:8000/v1",
      "connect_timeout_ms": 2000,
      "first_event_timeout_ms": 120000,
      "stall_timeout_ms": 90000,
      "max_in_flight": 8
    },
    "vllm-b": {
      "type": "openai-compatible",
      "base_url": "http://vllm-b.internal:8000/v1",
      "api_key_env": "VLLM_B_API_KEY"
    },
    "azure-westeurope": {
      "type": "azure-openai",
      "base_url": "https://acme-westeurope.openai.azure.com",
