{
  "reason": "child_defaults limits merge under each direct child's own: a child's limit replaces the default of the same type in place, the rest are appended; grandchildren get nothing from it",
  "config": {
    "format_version": 5,
    "global": {},
    "backends": { "local": { "type": "openai-compatible", "base_url": "http://localhost:8000/v1" } },
    "models": {
      "a": {
        "deployments": [{ "backend": "local", "model": "a" }],
        "metadata": {
          "context_length": 4096,
          "capabilities": { "streaming": true, "tools": false, "vision": false, "reasoning": false }
        }
      },
      "b": {
        "deployments": [{ "backend": "local", "model": "b" }],
        "metadata": {
          "context_length": 4096,
          "capabilities": { "streaming": true, "tools": false, "vision": false, "reasoning": false }
        }
      },
      "c": {
        "deployments": [{ "backend": "local", "model": "c" }],
        "metadata": {
          "context_length": 4096,
          "capabilities": { "streaming": true, "tools": false, "vision": false, "reasoning": false }
        }
      }
    },
    "groups": {
      "parent": {
        "limits": [{ "type": "usd_per_month", "value": 100 }],
        "child_defaults": {
          "limits": [
            { "type": "requests_per_minute", "value": 10 },
            { "type": "tokens_per_hour", "value": 1000 }
          ]
        }
      },
      "defaults-only": { "parent": "parent" },
      "override-reordered": {
        "parent": "parent",
        "limits": [
          { "type": "tokens_per_hour", "value": 2000 },
          { "type": "requests_per_minute", "value": 7 }
        ]
      },
      "override-and-add": {
        "parent": "parent",
        "limits": [
          { "type": "tokens_per_minute", "value": 500 },
          { "type": "requests_per_minute", "value": 20 }
        ]
      },
      "grandchild": { "parent": "defaults-only" }
    },
    "keys": {}
  },
  "expected": {
    "groups": {
      "parent": {
        "path": ["parent"],
        "allowed_models": "all",
        "limits": [{ "type": "usd_per_month", "value": 100 }]
      },
      "defaults-only": {
        "path": ["parent", "defaults-only"],
        "allowed_models": "all",
        "limits": [
          { "type": "requests_per_minute", "value": 10 },
          { "type": "tokens_per_hour", "value": 1000 }
        ]
      },
      "override-reordered": {
        "path": ["parent", "override-reordered"],
        "allowed_models": "all",
        "limits": [
          { "type": "requests_per_minute", "value": 7 },
          { "type": "tokens_per_hour", "value": 2000 }
        ]
      },
      "override-and-add": {
        "path": ["parent", "override-and-add"],
        "allowed_models": "all",
        "limits": [
          { "type": "requests_per_minute", "value": 20 },
          { "type": "tokens_per_hour", "value": 1000 },
          { "type": "tokens_per_minute", "value": 500 }
        ]
      },
      "grandchild": {
        "path": ["parent", "defaults-only", "grandchild"],
        "allowed_models": "all",
        "limits": []
      }
    }
  }
}
